{
  "name": "prod-forge-todolist-backend",
  "version": "1.0.0",
  "description": "Real-world backend architecture patterns, production mistakes and lessons learned building scalable systems.",
  "repository": {
    "type": "git",
    "url": "https://github.com/prod-forge/backend.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com>",
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate",
    "db:init": "prisma migrate deploy && prisma generate",
    "db:migrate": "prisma migrate dev --name",
    "db:migration:apply": "npm run db:wait && npm run db:migration:deploy",
    "db:migration:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:wait": "tsx ./database-manager/wait-for-db.ts",
    "doctor": "nestjs-doctor .",
    "format": "npm run format:prettier && npm run format:code",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write \"src/**/*.{ts,json}\"",
    "knip": "knip",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:commit": "commitlint --config .commitlintrc.cjs --edit",
    "lint:ts": "tsc --noEmit",
    "openapi:check": "ts-node ./scripts/export-openapi.ts --check",
    "openapi:export": "ts-node ./scripts/export-openapi.ts",
    "pre-commit": "lint-staged --config .lintstagedrc.cjs",
    "prepare": "husky",
    "release": "tsx release/before-release.ts && npx release-it",
    "start": "cross-env NODE_ENV=development nest start",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:cov": "cross-env NODE_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config test/setup/jest-e2e.json --runInBand",
    "test:e2e:cov": "cross-env NODE_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config test/setup/jest-e2e.json --runInBand --coverage",
    "test:load": "k6 run load/k6-smoke.js",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --watch",
    "token:issue": "tsx ./scripts/issue-token.ts"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/main.ts",
      "!**/*.module.ts",
      "!**/*.spec.ts",
      "!**/app.setup.ts",
      "!**/app.swagger.ts",
      "!**/*.config.ts",
      "!**/*.interface.ts",
      "!**/*.enum.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!**/*di.types.ts",
      "!**/*.constants.ts",
      "!**/instrument.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      ".+\\.(t|j)s$": "ts-jest"
    }
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@scalar/nestjs-api-reference": "1.2.34",
    "@sentry/node": "11.11.0",
    "@sentry/profiling-node": "11.11.0",
    "@willsoto/nestjs-prometheus": "7.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-http-context": "2.0.1",
    "helmet": "8.3.0",
    "ioredis": "5.10.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@inquirer/checkbox": "5.2.8",
    "@inquirer/prompts": "8.7.5",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.3",
    "@release-it/conventional-changelog": "11.0.0",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-package-json": "1.12.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "nestjs-doctor": "0.9.10",
    "prettier": "3.9.10",
    "release-it": "20.0.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  }
}
