                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": { "status": "up", "responseTime": 12 },
                        "redis": { "status": "down", "message": "Could not connect", "responseTime": 3005 }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Health"]
      }
    },
    "/api/version": {
      "get": {
        "operationId": "VersionController_check",
        "parameters": [],
        "responses": { "200": { "description": "" }, "500": { "description": "Internal server error" } },
        "tags": ["Version"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginDto" } } }
        },
        "responses": {
          "200": {
            "description": "Exchange a registered email for a signed access token. Development stub: no password is checked.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [{ "properties": { "data": { "$ref": "#/components/schemas/TokenResponseDto" } } }]
                }
              }
            }
          },
          "401": {
            "description": "USER_IS_NOT_AUTHORIZED: User is not authorized",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiErrorDto" },
                    {
                      "properties": {
                        "code": { "example": "USER_IS_NOT_AUTHORIZED" },
                        "message": { "example": "User is not authorized" },
                        "status": { "example": 401 }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "DTO_VALIDATION_ERROR: Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiErrorDto" },
                    {
                      "properties": {
                        "code": { "example": "DTO_VALIDATION_ERROR" },
                        "message": { "example": "Validation Error" },
                        "status": { "example": 422 }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiErrorDto" },
                    {
                      "properties": {
                        "code": { "example": "INTERNAL_ERROR" },
                        "message": { "example": "Internal Server Error" },
                        "status": { "example": 500 }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [{ "none": [] }],
        "summary": "Login",
        "tags": ["Auth"]
      }
    }
  },
  "info": {
    "title": "Prod Forge Todo API",
    "description": "REST API of the Prod Forge todo list",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "access-token": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" } },
    "schemas": {
      "MobileLogDto": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "Arbitrary log payload — structure TBD"
          },
          "platform": { "type": "string", "description": "Mobile platform", "example": "ios", "maxLength": 50 },
          "timestamp": { "type": "string", "example": "2026-05-18T08:16:13.163Z" },
          "traceId": { "type": "string", "example": "9c226319-abcc-4d6c-a1b6-f5d1cf18b6ae" }
        },
        "required": ["payload", "platform", "timestamp", "traceId"]
      },
      "WebLogActionDto": {
        "type": "object",
        "properties": {
          "ctx": { "type": "string", "description": "Context or module that produced the action", "maxLength": 100 },
          "level": {
            "type": "string",
            "enum": ["critical", "debug", "error", "info", "log", "warn"],
            "example": "info"
          },
          "message": { "type": "string", "example": "Fetching todo", "maxLength": 2000 },
          "payload": { "type": "object", "additionalProperties": true, "description": "Arbitrary action payload" },
          "stack": { "type": "string", "description": "Error stack trace", "maxLength": 10000 }
        },
        "required": ["ctx", "level", "message", "payload"]
      },
      "WebLogMetadataDto": {
        "type": "object",
        "properties": {
          "browser": { "type": "string", "example": "Chrome", "maxLength": 100 },
          "browserVersion": { "type": "string", "example": "148.0.0.0", "maxLength": 100 },
          "devicePixelRatio": { "type": "number", "example": 2 },
          "fullUrl": { "type": "string", "example": "http://localhost:5173/todo/abc", "maxLength": 2000 },
          "language": { "type": "string", "example": "en-US", "maxLength": 35 },
          "mobile": { "type": "boolean", "example": false },
          "os": { "type": "string", "example": "macOS 10.15.7", "maxLength": 100 },
          "screen": { "type": "string", "example": "1728x1117", "maxLength": 50 },
          "timezone": { "type": "string", "example": "Europe/London", "maxLength": 100 },
          "url": { "type": "string", "example": "/todo/abc", "maxLength": 2000 },
          "viewport": { "type": "string", "example": "1046x920", "maxLength": 50 }
        },
        "required": [
          "browser",
          "browserVersion",
          "devicePixelRatio",
          "fullUrl",
          "language",
          "mobile",
          "os",
          "screen",
          "timezone",
          "url",
          "viewport"
        ]
      },
      "WebLogDto": {
        "type": "object",
        "properties": {
          "actions": { "maxItems": 100, "type": "array", "items": { "$ref": "#/components/schemas/WebLogActionDto" } },
          "env": { "type": "string", "example": "production", "maxLength": 50 },
          "metadata": { "$ref": "#/components/schemas/WebLogMetadataDto" },
          "timestamp": { "type": "string", "example": "2026-05-18T08:16:13.163Z" },
          "traceId": { "type": "string", "example": "9c226319-abcc-4d6c-a1b6-f5d1cf18b6ae" }
        },
        "required": ["actions", "env", "metadata", "timestamp", "traceId"]
      },
      "CreateTodoDto": {
        "type": "object",
        "properties": {
          "completed": { "type": "boolean", "default": false },
          "description": { "type": "string", "maxLength": 2000 },
          "title": { "type": "string", "maxLength": 200 }
        },
        "required": ["title"]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "limit": { "type": "number", "example": 10 },
          "offset": { "type": "number", "description": "Zero-based number of rows skipped", "example": 0 },
          "total": { "type": "number", "example": 20 }
        },
        "required": ["limit", "offset", "total"]
      },
      "PaginatedResponseDto": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "type": "array" } },
          "meta": { "$ref": "#/components/schemas/PaginationMetaDto" }
        },
        "required": ["data", "meta"]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "DATABASE_ERROR",
              "DTO_VALIDATION_ERROR",
              "FORBIDDEN",
              "HTTP_EXCEPTION",
              "INFRA_FAILURE",
              "INTERNAL_ERROR",
              "NOT_FOUND",
              "PAYLOAD_TOO_LARGE",
              "REDIS_ERROR",
              "TODO_NOT_FOUND",
              "TOO_MANY_REQUESTS",
              "USER_IS_NOT_AUTHORIZED",
              "USER_NOT_FOUND"
            ]
          },
          "details": { "type": "object" },
          "message": { "type": "string", "example": "Error message" },
          "traceId": { "type": "string", "example": "trace-id" }
        },
        "required": ["code", "message"]
      },
      "TodoResponseDto": {
        "type": "object",
        "properties": {
          "completed": { "type": "boolean" },
          "description": { "type": "object", "nullable": true },
          "id": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["completed", "id", "title"]
      },
      "UpdateTodoDto": {
        "type": "object",
        "properties": {
          "completed": { "type": "boolean", "default": false },
          "description": { "type": "string", "maxLength": 2000 },
          "title": { "type": "string", "maxLength": 200 }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": { "email": { "type": "string", "example": "user1@example.com", "maxLength": 254 } },
        "required": ["email"]
      }
    }
  },
  "externalDocs": {
    "description": "For Validation Errors please check class-validator",
    "url": "https://github.com/typestack/class-validator#validation-errors"
  }
}
